# Copy to app_config.env. The app reads it at start-up; nothing is baked
# into the code. The name must not start with a dot: Netlify and some
# other static hosts refuse to publish dotfiles.
#
# Base URL of the Stark VMS API, with no trailing slash.
#   local web/desktop : http://localhost:8080
#   Android emulator  : http://10.0.2.2:8080
#   deployed          : https://api.example.com
API_BASE_URL=http://localhost:8080
